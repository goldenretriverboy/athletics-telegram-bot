# Runtime
APP_ENV=development
LOG_LEVEL=INFO
AUTO_PUBLISH=false
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Railway Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/athletics_bot

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHANNEL_ID=@beyond_the_1ine
TELEGRAM_DRAFT_CHAT_ID=replace_with_your_user_or_private_channel_id
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# OpenAI API
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-sol
OPENAI_HOURLY_MODEL=gpt-5.6-sol
OPENAI_STRONG_MODEL=gpt-5.6-sol
OPENAI_WEB_SEARCH_ENABLED=true

# Editorial
TIMEZONE=Asia/Almaty
MAX_DRAFTS_PER_RUN=3
HOURLY_NO_NEWS_STATUS_ENABLED=true
HOURLY_NO_NEWS_NOTIFY_AFTER_RUNS=4
DUPLICATE_STORY_LOOKBACK_DAYS=14
DUPLICATE_STORY_SIMILARITY_THRESHOLD=0.42
